$source = "D:\ocrr\PII_redaction"

@'
# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local environment files and credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx

# Runtime jobs, uploads, OCR data, and generated reports
/backend/jobs/
**/checkpoints/
**/run_*/
*.pages.json
*.audit.json
*.eval.json
*.review.json
processing_summary.json
job.json
*.log

# OS files
.DS_Store
Thumbs.db
'@ | Set-Content -LiteralPath (Join-Path $source ".gitignore") -Encoding utf8